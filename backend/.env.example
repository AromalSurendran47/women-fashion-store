# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/aura_fashion
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/aura_fashion
MONGODB_URI="mongodb://127.0.0.1:27017/aura_fashion"

# Port the Express API server listens on
PORT=5000

# Secret used to sign JWT auth tokens.
# Generate a strong one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# How many of each entity the seed generator should create (optional overrides)
SEED_USERS=20
SEED_PRODUCTS=100
SEED_REVIEWS=250
SEED_ORDERS=60
