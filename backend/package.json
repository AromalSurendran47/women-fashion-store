{
  "name": "aura-women-fashion-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Premium women's fashion eCommerce — data layer, Mongoose models and seed generator",
  "scripts": {
    "seed": "tsx seed/seed.ts",
    "seed:json": "tsx seed/seed.ts --json-only",
    "seed:mongo": "tsx seed/seed.ts --mongo-only",
    "import": "node seed/seed.js",
    "server": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.10",
    "dotenv": "^16.4.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
